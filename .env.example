# Copy to .env and fill in real values before running docker compose

# PostgreSQL
POSTGRES_PASSWORD=logiq

# OpenAI (used for embeddings)
OPENAI_API_KEY=sk-...

# Anthropic Claude (default LLM provider)
ANTHROPIC_API_KEY=sk-ant-...

# OpenRouter (alternative LLM provider)
OPENROUTER_API_KEY=sk-or-...

# LogIQ API key (leave empty for local dev — auth is off by default)
LOGIQ_API_KEY=

# Grafana admin password
GRAFANA_PASSWORD=admin
